{
  "name": "pi-bot",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "node main.ts",
    "tui": "node tui.ts",
    "systemd:install": "bash scripts/systemd.sh install",
    "systemd:uninstall": "bash scripts/systemd.sh uninstall",
    "systemd:start": "systemctl --user start pi-bot",
    "systemd:stop": "systemctl --user stop pi-bot",
    "systemd:restart": "systemctl --user restart pi-bot",
    "systemd:status": "systemctl --user --no-pager status pi-bot",
    "logs": "journalctl --user -u pi-bot -f",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "smoke": "node scripts/smoke.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/turndown": "^5.0.6",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "marked": "^18.0.5",
    "turndown": "^7.2.4",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^25.6.0"
  }
}
