# Secrets and deployment-specific values. Non-secret app defaults live in src/config.ts.

# Required
TELEGRAM_BOT_TOKEN=
# The only Telegram chat allowed to use this bot. All other chats are ignored.
TELEGRAM_ALLOWED_CHAT_ID=

# Model/provider credentials
OPENROUTER_API_KEY=
# For openai-codex models, authenticate with Pi first: pi → /login openai-codex
# Optional runtime override if you have a Codex bearer token:
# OPENAI_CODEX_API_KEY=

# Optional: Google GenAI voice/audio transcription and voice-note replies
GOOGLE_GENAI_API_KEY=

# Optional: ElevenLabs voice/audio transcription and voice-note replies
ELEVENLABS_API_KEY=

# Optional: web search
TAVILY_API_KEY_1=
# TAVILY_API_KEY_2=

# Optional: image generation skill
KIE_API_KEY=

# Optional: shared agent preferences. A gist owned by jerilseb, read once at
# startup and appended to the system prompt; editing it takes effect on restart.
# Must be the raw URL naming one file, so a multi-file gist stays unambiguous. The
# revision SHA the "Raw" button adds is dropped — it would serve the same text forever.
# CONTEXT_GIST_URL=https://gist.githubusercontent.com/jerilseb/<gist-id>/raw/<file>
