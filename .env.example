# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

CHAT_MODEL=openai-codex/gpt-5.4-mini
BACKGROUND_MODEL=openai-codex/gpt-5.5
ALLOWED_MODELS=openai-codex/gpt-5.4-mini,openai-codex/gpt-5.5,openrouter/moonshotai/kimi-k2.6
OPENROUTER_API_KEY=
# For openai-codex models, authenticate with Pi first: pi → /login openai-codex
# Optional runtime override if you have a Codex bearer token:
# OPENAI_CODEX_API_KEY=

# Optional: ElevenLabs voice/audio transcription and voice-note replies
ELEVENLABS_API_KEY=

# Optional: Telegram voice-note replies using ElevenLabs TTS
# Required for the agent's send_voice_note tool
ELEVENLABS_TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_TTS_OUTPUT_FORMAT=opus_48000_32
# PI_CHANNEL_MAX_TTS_CHARS=2500

# Optional: web search
TAVILY_API_KEY_1=
# TAVILY_API_KEY_2=

# Optional: image generation skill
KIE_API_KEY=

# Scheduled heartbeat is always enabled. Uses TELEGRAM_ALLOWED_CHAT_ID and files/heartbeat.md.
PI_HEARTBEAT_INTERVAL_SECONDS=3600

# Optional: channel behavior
PI_CHANNEL_IDLE_TIMEOUT_MINUTES=120
PI_CHANNEL_MAX_QUEUE_PER_CHAT=5
PI_CHANNEL_SEND_LOCAL_DOCUMENTS=true
