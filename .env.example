# Secrets and deployment-specific values. Non-secret app defaults live in src/config.ts.

# Required
TELEGRAM_BOT_TOKEN=
# The only Telegram chat allowed to use this bot. All other chats are ignored.
TELEGRAM_ALLOWED_CHAT_ID=

# Model/provider credentials
OPENROUTER_API_KEY=
# For openai-codex models, authenticate with Pi first: pi → /login openai-codex
# Optional runtime override if you have a Codex bearer token:
# OPENAI_CODEX_API_KEY=

# Models for the two unattended features (provider/model). There is no default:
# unset means the heartbeat does not run, and enabling it in files/settings.json
# without setting its model here is a startup error. It must resolve to a model
# whose provider has auth. Scheduled tasks need no model here: each is pinned at
# creation to the chat model active then, unless the user names one.
# Required when files/settings.json sets "heartbeat": true
# HEARTBEAT_MODEL=openai-codex/gpt-5.6-luna

# Optional: sub-agents. When true, the agent gets subagent_run and friends and can
# delegate self-contained tasks to concurrent worker sessions (transcripts under
# sessions/subagent-sessions/). Off by default: a worker is a whole extra agent
# spending tokens on its own. Any value other than true or false is a startup error.
# ENABLE_SUBAGENTS=true

# Optional: Google GenAI voice/audio transcription and voice-note replies
GOOGLE_GENAI_API_KEY=

# Optional: ElevenLabs voice/audio transcription and voice-note replies
ELEVENLABS_API_KEY=

# Optional: web search
TAVILY_API_KEY_1=
# TAVILY_API_KEY_2=


# Optional: shared agent preferences. A gist owned by jerilseb, read once at
# startup and appended to the system prompt; editing it takes effect on restart.
# Must be the raw URL naming one file, so a multi-file gist stays unambiguous. The
# revision SHA the "Raw" button adds is dropped — it would serve the same text forever.
# CONTEXT_GIST_URL=https://gist.githubusercontent.com/jerilseb/<gist-id>/raw/<file>
