# Secrets and deployment-specific values. Non-secret app defaults live in src/config.ts.

# Model/provider credentials
OPENROUTER_API_KEY=
# For openai-codex models, authenticate with Pi first: pi → /login openai-codex
# Optional runtime override if you have a Codex bearer token:
# OPENAI_CODEX_API_KEY=

# Optional: Google GenAI voice/audio transcription and voice-note replies
# GEMINI_API_KEY is also accepted.
GOOGLE_GENAI_API_KEY=

# Optional: ElevenLabs voice/audio transcription and voice-note replies
ELEVENLABS_API_KEY=

# Optional: web search
TAVILY_API_KEY_1=
# TAVILY_API_KEY_2=

# Optional: image generation skill
KIE_API_KEY=

# Web UI server (defaults: 127.0.0.1:8787)
# WEB_UI_HOST=127.0.0.1
# WEB_UI_PORT=8787

# Dev-server HTTPS: when set, `npm run dev:web` serves https://<host>:5173 using
# certs/<host>.crt and certs/<host>.key (e.g. a Tailscale cert). Required for
# microphone + Web Push on iOS Safari. Leave unset for plain-HTTP dev.
# WEB_TLS_HOST=laptop.marten-lake.ts.net

# Optional: Web Push notifications (PWA). Disabled unless WEB_PUSH_ENABLED=true.
# Generate VAPID keys with: npx web-push generate-vapid-keys
# WEB_PUSH_ENABLED=true
# WEB_PUSH_VAPID_PUBLIC=
# WEB_PUSH_VAPID_PRIVATE=
# WEB_PUSH_SUBJECT=mailto:you@example.com
